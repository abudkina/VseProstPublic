# =============================================================================
# Конфигурация для хостинга Beget
# =============================================================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.beget .env
# =============================================================================

# -----------------------------------------------------------------------------
# Режим работы
# -----------------------------------------------------------------------------
FLASK_ENV=production

# -----------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!)
# -----------------------------------------------------------------------------
# Сгенерируйте уникальный ключ командой:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ_МИНИМУМ_64_СИМВОЛА

# Время жизни токенов (в секундах)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# -----------------------------------------------------------------------------
# База данных MySQL (Beget)
# -----------------------------------------------------------------------------
# Данные из панели Beget -> MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=ЛОГИН_BEGET_ИМЯ_БД
DB_PASSWORD=ПАРОЛЬ_ОТ_БД
DB_NAME=ЛОГИН_BEGET_ИМЯ_БД
DB_USE_SSL=false

# -----------------------------------------------------------------------------
# CORS - разрешённые домены
# -----------------------------------------------------------------------------
# Укажите ваш домен (через запятую если несколько)
CORS_ORIGINS=https://ваш-домен.ru,https://www.ваш-домен.ru

# -----------------------------------------------------------------------------
# URL фронтенда
# -----------------------------------------------------------------------------
# Для ссылок в email (восстановление пароля)
FRONTEND_URL=https://ваш-домен.ru

# -----------------------------------------------------------------------------
# Email настройки (для восстановления пароля)
# -----------------------------------------------------------------------------
# Yandex SMTP
MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=ваш-email@yandex.ru
MAIL_PASSWORD=пароль-приложения-яндекс
MAIL_DEFAULT_SENDER=ваш-email@yandex.ru
MAIL_DEBUG=false

# Время жизни токена сброса пароля (1 час)
PASSWORD_RESET_TOKEN_EXPIRES=3600

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# На shared-хостинге Redis недоступен, используем memory
RATELIMIT_STORAGE_URL=memory://

# -----------------------------------------------------------------------------
# OpenAI API (опционально - для генерации изображений)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=ваш-ключ
# OPENAI_API_URL=https://api.proxyapi.ru/openai/v1

# -----------------------------------------------------------------------------
# Yandex Object Storage (опционально - для хранения файлов)
# -----------------------------------------------------------------------------
# YANDEX_STORAGE_ACCESS_KEY=ваш-ключ
# YANDEX_STORAGE_SECRET_KEY=ваш-секрет
# YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
# YANDEX_STORAGE_BUCKET=имя-бакета
