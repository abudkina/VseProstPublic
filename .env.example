# Скопируйте в .env и заполните значения: cp .env.example .env

# -----------------------------------------------------------------------------
# Режим работы
# -----------------------------------------------------------------------------
FLASK_ENV=development

# -----------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!)
# -----------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ_МИНИМУМ_64_СИМВОЛА

JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# -----------------------------------------------------------------------------
# База данных MySQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=vseprost
DB_USE_SSL=false

DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_USER=root
DEV_DB_PASSWORD=your_dev_db_password
DEV_DB_NAME=vseprost

# -----------------------------------------------------------------------------
# CORS — разрешённые домены (через запятую)
# Для GitHub Pages добавьте: https://ВАШ_ЛОГИН.github.io
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# URL для экспорта статики (scripts/export_static_data.py)
# STATIC_BASE_URL=https://abudkina.github.io/VseProstPublic

FRONTEND_URL=http://127.0.0.1:8080
BASE_URL=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=your-email@yandex.ru
MAIL_PASSWORD=app-password-here
MAIL_DEFAULT_SENDER=your-email@yandex.ru
MAIL_DEBUG=false

PASSWORD_RESET_TOKEN_EXPIRES=3600

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATELIMIT_STORAGE_URL=memory://

# -----------------------------------------------------------------------------
# OpenAI API (опционально)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.proxyapi.ru/openai/v1
# OPENAI_API_URL2=https://api.proxyapi.ru/openrouter/v1

# -----------------------------------------------------------------------------
# Yandex Object Storage (опционально)
# -----------------------------------------------------------------------------
# YANDEX_STORAGE_ACCESS_KEY=
# YANDEX_STORAGE_SECRET_KEY=
# YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
# YANDEX_STORAGE_BUCKET=your-bucket
