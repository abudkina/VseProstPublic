# =============================================================================
# VSEPROST ENVIRONMENT CONFIGURATION
# =============================================================================
# ⚠️ SECURITY WARNING:
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env file to git repository!
# 3. Generate strong random secrets for production
# 4. Rotate secrets regularly
# =============================================================================

# -----------------------------------------------------------------------------
# Flask Environment
# -----------------------------------------------------------------------------
FLASK_ENV=development  # Options: development, production, testing

# -----------------------------------------------------------------------------
# Security - JWT Configuration
# -----------------------------------------------------------------------------
# 🔐 CRITICAL: Generate a strong secret key for JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-THIS-TO-RANDOM-64-CHARACTER-HEX-STRING-IMMEDIATELY

# JWT token expiration times (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=900        # 15 minutes (recommended for security)
JWT_REFRESH_TOKEN_EXPIRES=604800    # 7 days (recommended for security)

# -----------------------------------------------------------------------------
# Database Configuration - Development
# -----------------------------------------------------------------------------
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_USER=root
DEV_DB_PASSWORD=your-strong-database-password-here
DEV_DB_NAME=vseprost

# -----------------------------------------------------------------------------
# Database Configuration - Production
# -----------------------------------------------------------------------------
DB_HOST=your-production-db-host
DB_PORT=3306
DB_USER=your-production-db-user
DB_PASSWORD=your-strong-production-db-password
DB_NAME=vseprost
DB_USE_SSL=true  # MUST be true in production!

# Database SSL Certificates (required for production with SSL)
# DB_SSL_CA=/path/to/ca-cert.pem
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# ⚠️ Comma-separated list - be restrictive in production!
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# -----------------------------------------------------------------------------
# OpenAI API Configuration (for image generation)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_URL=https://api.proxyapi.ru/openai/v1

# -----------------------------------------------------------------------------
# Yandex Object Storage Configuration
# -----------------------------------------------------------------------------
YANDEX_STORAGE_ACCESS_KEY=your-yandex-access-key
YANDEX_STORAGE_SECRET_KEY=your-yandex-secret-key
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YANDEX_STORAGE_BUCKET=your-bucket-name

# -----------------------------------------------------------------------------
# Email Configuration (Yandex SMTP)
# -----------------------------------------------------------------------------
MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=your-email@yandex.ru
MAIL_PASSWORD=your-yandex-app-password  # Use app-specific password!
MAIL_DEFAULT_SENDER=your-email@yandex.ru
MAIL_DEBUG=false

# -----------------------------------------------------------------------------
# Password Reset Configuration
# -----------------------------------------------------------------------------
PASSWORD_RESET_TOKEN_EXPIRES=3600  # 1 hour
FRONTEND_URL=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8080

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATELIMIT_STORAGE_URL=redis://localhost:6379  # or memory:// for development
RATELIMIT_DEFAULT=200/hour
RATELIMIT_LOGIN=5/minute
RATELIMIT_REGISTER=3/hour
RATELIMIT_PASSWORD_RESET=3/hour
